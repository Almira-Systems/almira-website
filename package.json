{
  "name": "shopify-test",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "check": "next lint && tsc --noEmit",
    "db:generate": "prisma migrate dev",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "dev": "NODE_OPTIONS=\"--inspect\" next dev --turbo --port 3005",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "postinstall": "prisma generate",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "preview": "next build && next start",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "codegen": "graphql-codegen --config ./src/lib/codegen.ts",
    "codegen:watch": "graphql-codegen --config ./src/lib/codegen.ts --watch"
  },
  "dependencies": {
    "@apollo/client": "^4.2.3",
    "@base-ui/react": "^1.5.0",
    "@floating-ui/core": "^1.7.5",
    "@floating-ui/dom": "^1.7.6",
    "@floating-ui/react": "^0.27.19",
    "@graphql-codegen/typescript": "^6.0.2",
    "@prisma/client": "^6.19.3",
    "@shopify/hydrogen": "^2026.4.3",
    "@shopify/storefront-api-client": "^1.0.10",
    "@t3-oss/env-nextjs": "^0.12.0",
    "@tanstack/react-query": "^5.101.0",
    "gql-tag": "^1.0.1",
    "graphql": "^16.14.2",
    "graphql-tag": "^2.12.6",
    "jotai": "^2.20.1",
    "js-cookie": "^3.0.8",
    "lucide-react": "^1.17.0",
    "next": "^16.2.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sass": "^1.100.0",
    "utopia-core-scss": "^1.3.1",
    "zod": "^3.25.76",
    "zod-form-data": "^3.0.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@graphql-codegen/cli": "^7.1.2",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@shopify/api-codegen-preset": "^2.0.0",
    "@types/js-cookie": "^3.0.6",
    "@types/lodash": "^4.17.24",
    "@types/node": "^20.19.43",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "csv-parse": "^6.2.1",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.9",
    "exceljs": "^4.4.0",
    "papaparse": "^5.5.3",
    "prettier": "^3.8.4",
    "prisma": "^6.19.3",
    "ts-to-zod": "^5.1.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0"
  },
  "ct3aMetadata": {
    "initVersion": "7.40.0"
  },
  "packageManager": "pnpm@11.6.0"
}
